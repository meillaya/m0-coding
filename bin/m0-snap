#!/usr/bin/env bash
# Freeze a provisioned VM into the reusable "golden master" image.
#
# Snapshots are versioned: re-running with the same image name adds a new
# version (you promote a version to make it current). The flake revision is
# recorded as image metadata so a VM can be traced back to a commit.
#
#   bin/m0-snap m0-dev
#   bin/m0-snap m0-dev m0-coding "coding image v2"
set -euo pipefail
cd "$(dirname "$0")/.."

vm="${1:?usage: m0-snap <vm> [image-name] [description]}"
image="${2:-$(jq -r '.profiles[0].image' manifest.json)}"
desc="${3:-coding image $(git rev-parse --short HEAD 2>/dev/null || echo no-git)}"

rev="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
dirty="$(git status --porcelain 2>/dev/null | head -c 200 || true)"

# `machine0 stop` insists on RUNNING, and a STOPPED VM (re-freezing the same
# box after a previous snapshot) is already in the state the snapshot wants.
# SUSPENDED has no instance at all, so it has to be resumed first.
status="$(machine0 get "$vm" --json 2>/dev/null | jq -r '.status // empty')"
case "$status" in
  RUNNING)
    echo "==> stopping $vm"
    machine0 stop "$vm"
    ;;
  STOPPED)
    echo "==> $vm is already STOPPED"
    ;;
  *)
    echo "error: $vm is ${status:-unknown} — start it first: machine0 start $vm" >&2
    exit 1
    ;;
esac

echo "==> snapshotting $vm -> image '$image'"
# Canonical spelling in CLI 1.0.164; the docs/website call it `images new`
# (accepted as an alias, same command).
machine0 images save "$vm" "$image" \
  -d "$desc" \
  -m "$(jq -nc --arg rev "$rev" --arg dirty "$dirty" \
        '{flakeRev:$rev, uncommitted:($dirty|length>0)}')"

echo
machine0 images get "$image"
echo
echo "==> new project VMs:  bin/m0-new <project> [size] [profile]"
echo "    make it the default:  machine0 config set DEFAULT_VM_IMAGE=$image"
