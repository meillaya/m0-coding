#!/usr/bin/env bash
# Create (or refresh) a NixOS VM from THIS flake, then verify the agents.
#
# The flake is synced from the local working tree by `machine0 provision`,
# so nothing has to be pushed to GitHub while you iterate.
#
#   bin/m0-dev                      # vm: m0-dev, size: large
#   bin/m0-dev mybox xl
set -euo pipefail
cd "$(dirname "$0")/.."

vm="${1:-m0-dev}"
size="${2:-large}"
profile="${3:-coding}"
base_image="${M0_BASE_IMAGE:-nixos-25-11-loaded}"
# machine0 profile whose integrations (claude/codex/github creds, MCPs) get
# injected into the VM. Injection happens at CREATE time, so a VM created
# without it has no agent credentials — re-create or use `profiles deploy`.
m0profile="${M0_PROFILE:-default}"

if ! command -v machine0 >/dev/null 2>&1; then
  echo "machine0 CLI not found. Install it:" >&2
  echo "  curl -LsSf https://machine0.io/install.sh | sh" >&2
  exit 1
fi

if machine0 get "$vm" --json >/dev/null 2>&1; then
  json="$(machine0 get "$vm" --json)"
  dist="$(jq -r '.distribution // empty' <<<"$json")"
  if [ "$dist" != "nixos" ]; then
    echo "error: $vm exists but is not a NixOS VM (distribution=$dist)" >&2
    exit 1
  fi
  status="$(jq -r '.status // empty' <<<"$json")"
  if [ "$status" != "RUNNING" ]; then
    # STOPPED and SUSPENDED VMs cannot be provisioned over ssh; `start`
    # resumes a suspended VM from its snapshot with the same name/size/region.
    echo "==> $vm exists but is $status — starting it"
    machine0 start "$vm"
  else
    echo "==> reusing running VM '$vm'"
  fi
else
  echo "==> creating '$vm' from $base_image ($size), machine0 profile '$m0profile'"
  # medium or larger: nix builds are CPU/RAM hungry, small is painful.
  machine0 new "$vm" --image "$base_image" --size "$size" --profile "$m0profile"
fi

echo "==> provisioning .#${profile} (syncs this flake, runs nixos-rebuild switch)"
# 10 minutes is the documented budget for a provision build.
machine0 provision "$vm" ".#${profile}"

echo "==> verifying agents on $vm"
# NOTE: machine0 ssh joins its arguments into one string that the remote shell
# re-parses, so `bash -lc '<script>'` collapses (the -lc argument gets eaten).
# Pass the script as a SINGLE argument instead; the default remote PATH already
# includes /etc/profiles/per-user/nix/bin, so a login shell is not needed.
machine0 ssh "$vm" '
  rc=0
  for c in claude codex hermes opencode devenv direnv just docker node pnpm uv gh; do
    if p=$(command -v "$c"); then printf "  ok    %s (%s)\n" "$c" "$p"; else printf "  MISS  %s\n" "$c"; rc=1; fi
  done
  echo
  if docker info >/dev/null 2>&1; then echo "  docker: up"; else echo "  docker: DOWN"; rc=1; fi
  # Credentials are injected by the machine0 profile at CREATE time (see
  # M0_PROFILE / --profile); a VM created without one has none of these.
  if [ -f ~/.config/gh/hosts.yml ]; then
    echo "  gh:     authenticated as $(gh api user -q .login 2>/dev/null || echo unknown)"
  else
    echo "  gh:     no credentials (VM not created with --profile)"
  fi
  [ -s ~/.codex/auth.json ] && echo "  codex:  authenticated" || echo "  codex:  NOT authenticated"
  [ -d ~/.claude ] && [ -n "$(ls -A ~/.claude 2>/dev/null)" ] && echo "  claude: authenticated" || echo "  claude: NOT authenticated (run: machine0 integrations connect claude-code)"
  exit $rc
'

echo
echo "==> ready:  machine0 ssh $vm"
echo "    when it is what you want, freeze it:  bin/m0-snap $vm"
